# ApplyPilot Environment Configuration
# Copy to your APPLYPILOT_DIR/.env and fill in your values locally.

# LLM Provider (pick one)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# GEMINI_API_KEY=         # Alternative provider; remove OpenAI settings first
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Browser applications separately require authenticated Claude Code and a reviewed
# application adapter. CAPTCHA, login, and verification gates need user input.

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
